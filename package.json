{
    "name": "alchemist-test-pilot",
    "version": "0.1.0",
    "description": "ATP — Obsidianプラグインの自動テストツール",
    "private": true,
    "scripts": {
        "test:cli": "node 'tests/core/（見張り番）monitor.js'",
